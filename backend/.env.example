# --- Groq LLM ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- PostgreSQL ---
DATABASE_URL=postgresql://legal_user:legal_pass@localhost:5432/legal_intelligence_db

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- App ---
APP_ENV=development
MAX_UPLOAD_MB=15
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K_RETRIEVAL=5
CORS_ORIGINS=http://localhost:8501,http://localhost:3000
